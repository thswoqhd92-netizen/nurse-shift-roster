{
  "folders": [
    {
      "path": ".",
      "name": "간호사 근무표 자동화"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.DS_Store": true,
      "**/Thumbs.db": true
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "실행",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "${env:ComSpec}",
        "runtimeArgs": ["/c", "실행.bat"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      },
      {
        "name": "열기",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "${env:ComSpec}",
        "runtimeArgs": ["/c", "열기.bat"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      },
      {
        "name": "브라우저로 열기",
        "type": "chrome",
        "request": "launch",
        "file": "${workspaceFolder}/index.html"
      }
    ]
  }
}
